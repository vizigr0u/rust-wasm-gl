#!/bin/sh
# enable once: git config core.hooksPath .githooks
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
[ -f "$HOME/.config/shell/env.sh" ] && . "$HOME/.config/shell/env.sh"
command -v cargo >/dev/null || { echo "pre-commit: cargo not found in PATH"; exit 1; }
cargo fmt --all --check || { echo "fmt failed: run 'cargo fmt --all'"; exit 1; }
